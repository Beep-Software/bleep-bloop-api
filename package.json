    "@types/node": "^22.15.17",
    "@types/nodemailer": "^8.0.1",
    "cross-env": "^10.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^10.1.1",
    "axios": "^1.9.0",
    "config": "^3.3.12",
    "dotenv": "^17.2.1",
    "fastify": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^11.0.1",
    "nodemailer": "^9.0.3"
  }
